{
  "name": "yangcheng",
  "description": "YangChengTeam 团队技能目录",
  "owner": {
    "name": "YangChengTeam"
  },
  "interface": {
    "displayName": "YangChengTeam 技能"
  },
  "plugins": [
    {
      "name": "zhiji-setup",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-setup"
      },
      "description": "创建智迹项目，安装上报、工单、仓库与知识库技能。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-work-report",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-work-report"
      },
      "description": "把当前项目自上次上报以来的新增工作总结成工作日志，上报到智迹，并查询 Token 用量。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-ticket",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-ticket"
      },
      "description": "把需要别人做的事提成工单并自动分配到处理组，或者处理分配给自己所在组的工单。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-image",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-image"
      },
      "description": "通过智迹调用团队生图服务，支持 gpt-image-2.5 等已配置模型，保存图片并查看调用记录。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-translate",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-translate"
      },
      "description": "通过智迹翻译文本或文件，指定目标语言，保存译文并查看调用记录。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-speech",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-speech"
      },
      "description": "通过智迹把文案合成为语音，选择模型、声音和格式，保存音频并查看调用记录。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-sfx",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-sfx"
      },
      "description": "通过智迹按文字描述生成音效，指定时长，保存音频并查看调用记录。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-doc",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-doc"
      },
      "description": "检索、阅读和上传智迹共享知识库；按 Android、iOS、AI 等分类查找团队经验。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "zhiji-repo",
      "source": {
        "source": "local",
        "path": "./plugins/zhiji-repo"
      },
      "description": "推送 GitLab 仓库，并搜索、阅读或提交仓库中的代码文件。",
      "category": "Productivity",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    }
  ]
}
